# Variables de entorno — copialo a `.env` y editá según tu caso.
# `.env` está en .gitignore para no commitear valores locales.

# MSW (Mock Service Worker) interceptor.
# - true  → mocks activos (default en dev, requerido en prod GH Pages)
# - false → fetch va al backend real (cuando exista)
VITE_USE_MSW=true

# URL pública canónica (sin slash final). El default commiteado vive
# en .env.production (GH Pages). `npm run build:domain` la pisa con
# https://ancestralseed.com para el hosting propio (Ferozo/FTP).
# VITE_SITE_URL=https://soyalantapia.github.io/ancestral-seed-app
