# Defaults de build de producción (commiteado — sin secretos).
# Vite lo carga en `vite build`; las vars de shell le ganan, así que
# `npm run build:domain` pisa VITE_SITE_URL con https://ancestralseed.com.
#
# Default = GitHub Pages, para que `npm run deploy` siga funcionando
# en cualquier clon aunque no exista .env local.
VITE_SITE_URL=https://soyalantapia.github.io/ancestral-seed-app
